; LuckeeMiner block renderer vertex shader
.fvec projection[4], modelView[4]

.constf constants(0.0, 1.0, 0.0, 0.0)
.alias zeros constants.xxxx
.alias ones constants.yyyy

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias inpos v0
.alias inclr v1
.alias intex v2

.proc main
    mov r0.xyz, inpos
    mov r0.w, ones

    dp4 r1.x, modelView[0], r0
    dp4 r1.y, modelView[1], r0
    dp4 r1.z, modelView[2], r0
    dp4 r1.w, modelView[3], r0

    dp4 outpos.x, projection[0], r1
    dp4 outpos.y, projection[1], r1
    dp4 outpos.z, projection[2], r1
    dp4 outpos.w, projection[3], r1

    mov outclr, inclr

    ; Java/OpenGL uses V=0 at the bottom of the image. PNG image data and
    ; PICA200 texture storage use the first image row at the top, so convert
    ; the incoming Java-style V coordinate here.
    mov outtc0.x, intex.x
    add outtc0.y, ones, -intex.y
    mov outtc0.zw, zeros

    end
.end
